# Placeholder names only. Copy to .env and fill in locally. Never commit real values.

# --- backend ---
AIRPOWER_DATABASE_URL=sqlite:///./airpower.db
# Signs the state bundle the browser caches when instances do not share a database (D-72).
# Use one random value per deployment; the default is fine for local dev.
AIRPOWER_STATE_SECRET=
AIRPOWER_SOLVER_TIME_LIMIT_S=20
AIRPOWER_SOLVER_WORKERS=4
AIRPOWER_SCENARIO_DIR=../scenarios

# Weather (used from Phase 7; open API, no key expected)
AIRPOWER_WEATHER_LAT=
AIRPOWER_WEATHER_LON=
AIRPOWER_WEATHER_API_BASE_URL=

# --- frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- docker compose db ---
POSTGRES_DB=airpower
POSTGRES_USER=airpower
POSTGRES_PASSWORD=change-me
